-- MAIN TAB
local Tab = Window:CreateTab("Network", 4483362458)
local Section = Tab:CreateSection("Connection Settings")

local uiPingToggle = Tab:CreateToggle({
    Name = "Show Ping Display",
    CurrentValue = false,
    Flag = "ShowPingDisplay",
    Callback = function(Value)
        pingFrame.Visible = Value
        Rayfield:Notify({Title = "Ping Display", Content = Value and "Enabled" or "Disabled", Duration = 3})
    end,
})

local uiBoostToggle = Tab:CreateToggle({
    Name = "Enable Client Optimizer",
    CurrentValue = false,
    Flag = "NetworkBoostToggle",
    Callback = function(Value)
        isBoostEnabled = Value
        if not isBoostEnabled then
            Lighting.GlobalShadows = origShadows
            Lighting.FogEnd = origFogEnd
            Lighting.EnvironmentDiffuseScale = origDiffuse
            Lighting.EnvironmentSpecularScale = origSpecular
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            Rayfield:Notify({Title = "Optimizer", Content = "Settings restored", Duration = 3})
        else
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 100000
            Rayfield:Notify({Title = "Optimizer", Content = "Client optimization enabled", Duration = 3})
        end
    end,
})

local uiBoostSlider = Tab:CreateSlider({
    Name = "Optimization Level",
    Range = {0, 100},
    Increment = 1,
    Suffix = "%",
    CurrentValue = 0,
    Flag = "NetworkBoostSlider",
    Callback = function(Value)
        boostPercent = Value
        if isBoostEnabled then
            local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(Lighting, tweenInfo, {
                EnvironmentDiffuseScale = math.max(0, 1 - (boostPercent / 100)),
                EnvironmentSpecularScale = math.max(0, 1 - (boostPercent / 100))
            }):Play()
            
            if boostPercent >= 50 then
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                for _, v in pairs(workspace:GetDescendants()) do
                    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then 
                        v.Enabled = false 
                    end
                end
            else
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level04
            end
        end
    end,
})

Tab:CreateButton({
    Name = "Clear Visual Lag (Flush)",
    Callback = function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then 
                v.Enabled = false 
            end
        end
        Rayfield:Notify({Title = "Success", Content = "Visual lag cleared", Duration = 3})
    end,
})

Tab:CreateButton({
