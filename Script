pingText.RichText = true 
pingText.Parent = pingFrame

local textStroke = Instance.new("UIStroke")
textStroke.Color = Color3.fromRGB(0, 0, 0) 
textStroke.Thickness = 3
textStroke.Parent = pingText

-- Draggable Logic
local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
pingFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = pingFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
pingFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        pingFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Real Ping Calculation Loop
RunService.RenderStepped:Connect(function()
    local pingValue = math.floor(player:GetNetworkPing() * 1000)
    pingText.Text = string.format('<font color="#FF0000">Ping</font> : <font color="#2AFF00">%d</font> ms', pingValue)
end)

